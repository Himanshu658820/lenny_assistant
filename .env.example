DATABASE_URL=postgresql://postgres:password@db:5432/lenny_assistant
OLLAMA_URL=http://ollama:11434
ANTHROPIC_API_KEY=your_api_key_here
DEFAULT_LLM_PROVIDER=ollama

# LLM provider: ollama | anthropic | openai
LLM_PROVIDER=ollama

# Ollama settings
# From inside Docker on Windows, host.docker.internal usually reaches the host machine.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud LLM keys
# Leave empty if you do not have keys yet.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# App settings
APP_ENV=development
LOG_LEVEL=INFO

# If you run FastAPI directly outside Docker, uncomment this:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lenny_growth_assistant

TOP_K = 8
RELEVANCE_THRESHOLD = 0.40